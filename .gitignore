# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# maquettes de référence (design uniquement, pas nécessaires au projet)
/espace-coach-admin.html
/espace-client.html

# config Claude Code locale (permissions propres à chaque poste)
.claude/settings.local.json
